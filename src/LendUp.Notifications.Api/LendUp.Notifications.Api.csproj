<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LendUp.Notifications.Api</RootNamespace>
    <AssemblyName>LendUp.Notifications.Api</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>lendup-notifications-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pomelo 9.0.0 es la última versión estable y exige EF Core 9.0.x (ver docs/decisions/0001). -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- Pomelo 9.0.0 trae MySqlConnector 2.4.0 (GHSA-473q-m89c-ghf8); se fija la versión parcheada. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LendUp.Notifications.Tests" />
  </ItemGroup>

</Project>
