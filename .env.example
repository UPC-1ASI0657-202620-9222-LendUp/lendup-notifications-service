SERVER_PORT=8083
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lendup_notificaciones
DB_USERNAME=lendup_notificaciones
DB_PASSWORD=change-me
DB_MIGRATE_ON_STARTUP=true
MYSQL_ROOT_PASSWORD=change-root-me
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=lendup_notificaciones
RABBITMQ_PASSWORD=change-me
FIREBASE_PROJECT_ID=replace-with-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=./.secrets/firebase-service-account.json
CORS_ORIGINS=http://localhost:5173
# Identidad (contratos pendientes). Sin token de servicio se reenvía el Authorization del usuario: en local
# IDENTITY_SERVICE_BASE_URL=http://host.docker.internal:8080 y IDENTITY_FIREBASE_USER_URI_TEMPLATE=/api/v1/estudiantes/me.
# El correo del destinatario requiere token de servicio e IDENTITY_USER_EMAIL_URI_TEMPLATE (variable {usuario_id}).
IDENTITY_SERVICE_BASE_URL=
IDENTITY_SERVICE_TOKEN=
IDENTITY_FIREBASE_USER_URI_TEMPLATE=
IDENTITY_USER_EMAIL_URI_TEMPLATE=
# SendGrid: sin API key los correos solo se registran en el log.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@lendup.example
SENDGRID_FROM_NAME=LendUp
EMAIL_MAX_ATTEMPTS=5
# Recordatorios (RF22)
REMINDER_DELIVERY_LEAD_HOURS=24
REMINDER_RETURN_LEAD_HOURS=24
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_DELAY_MS=60000
REMINDER_SCHEDULER_BATCH_SIZE=100
# Routing keys de productores que aún no publican (contratos pendientes, ver docs/events.md)
LOAN_ACTIVATED_ROUTING_KEY=prestamos.activado.v1
EXTENSION_ACCEPTED_ROUTING_KEY=prestamos.extension-aceptada.v1
LOAN_FINISHED_ROUTING_KEY=prestamos.finalizado.v1
INCIDENT_REPORTED_ROUTING_KEY=evidencias.incidencia-reportada.v1
INCIDENT_RESOLVED_ROUTING_KEY=evidencias.incidencia-resuelta.v1
SWAGGER_ENABLED=false
SWAGGER_PUBLIC=false
